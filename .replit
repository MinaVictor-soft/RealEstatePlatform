modules = ["dotnet-7.0", "nodejs-20", "web", "dotnet-8.0"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend API"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Frontend"

[[workflows.workflow]]
name = "Backend API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd Backend && dotnet run --project PropertyCollectionForecast.Api --urls http://0.0.0.0:5238"
waitForPort = 5238

[[workflows.workflow]]
name = "Frontend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd Frontend && npm run dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 5002
externalPort = 3000

[[ports]]
localPort = 5173
externalPort = 5173

[[ports]]
localPort = 5238
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "cd dist && ASPNETCORE_URLS=http://0.0.0.0:5238 dotnet PropertyCollectionForecast.Api.dll"]
build = ["bash", "-c", "dotnet publish Backend/PropertyCollectionForecast.Api/PropertyCollectionForecast.Api.csproj -c Release -o dist && cd Frontend && npm ci && npm run build"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

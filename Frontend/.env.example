# ---------------------------------------------------------------------------
# Frontend environment variables
# ---------------------------------------------------------------------------

# VITE_API_BASE_URL
# Used by the browser in *production* builds to reach the backend.
# In development the Vite dev-server proxy handles all /api/* traffic
# server-side (see vite.config.ts), so this variable is ignored during `npm
# run dev`.
#
# For a Replit deployment set this to the backend's public URL, e.g.:
#   VITE_API_BASE_URL=https://<your-repl>--5238.<username>.replit.dev
#
# Leave blank to use relative paths (works when frontend and backend are
# served from the same origin).
VITE_API_BASE_URL=

# BACKEND_URL (server-side only – not a VITE_ variable)
# Overrides the Vite proxy target used during development.
# Defaults to http://localhost:5238 when unset.
# Only needed if your backend runs on a different host or port.
# BACKEND_URL=http://localhost:5238
